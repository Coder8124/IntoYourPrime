<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSCameraUsageDescription</key>
    <string>IntoYourPrime uses your camera for live form analysis and basketball shot tracking. You can switch between front and back cameras during workouts.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>IntoYourPrime needs access to your photo library so you can upload workout video clips for AI form review.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Microphone access is required for video clip recording.</string>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
    </array>
    <key>CFBundleDisplayName</key>
    <string>IntoYourPrime</string>
    <key>CFBundleIdentifier</key>
    <string>com.intoyourprime.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations~iphone</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>GIDClientID</key>
    <string>YOUR_REVERSED_CLIENT_ID_HERE</string>
</dict>
</plist>
